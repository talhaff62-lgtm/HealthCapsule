# =============================================================================
# HealthCapsule — Environment Variables
# =============================================================================
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
#
# Then fill in the values. Never commit `.env.local` or any real `.env` file.
#
# Set the variables under "REQUIRED EVERYWHERE" in both dev and production.
# Set the storage variables for whichever backend you choose (see STORAGE).
# =============================================================================


# =============================================================================
# REQUIRED EVERYWHERE (dev + production)
# =============================================================================

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local dev example:  postgresql://postgres:postgres@localhost:5432/health_capsule
# Production:         your managed Postgres URL (Neon/Supabase/RDS) — add ?sslmode=require
# Used by: src/lib/prisma.ts (Prisma adapter-pg)
DATABASE_URL=

# Signing key for NextAuth sessions.
# Generate: openssl rand -base64 32
# Used by: next-auth (read internally, not via process.env in src/)
NEXTAUTH_SECRET=

# Public base URL of this app. No trailing slash.
# Dev:        http://localhost:3000
# Production: https://your-domain.vercel.app
# Used by: next-auth (read internally, not via process.env in src/)
NEXTAUTH_URL=

# Signing key for the staff/admin JSON API tokens (7-day expiry).
# Must be a DIFFERENT value from NEXTAUTH_SECRET.
# Generate: openssl rand -base64 32
# Without it, login succeeds but every authenticated API call fails to verify.
# Used by: src/lib/jwt-auth.ts
JWT_SECRET=


# =============================================================================
# SEEDING (only needed when running the seed scripts)
# =============================================================================

# Initial admin credentials created by `npm run seed:panel`.
# The script exits with code 1 if either is missing.
# Not read by the running app — only by prisma/seed-panel.ts.
# Safe to leave blank in production; set them in your shell for the one-off seed run.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=


# =============================================================================
# STORAGE (image uploads — doctors, hospitals, diagnostic centers)
# =============================================================================
# Pick ONE provider via STORAGE_PROVIDER, then fill that provider's block.
# The app throws on startup of the upload route if STORAGE_PROVIDER is unset.

# "local"    = writes files under public/. DEV ONLY.
#              Files written at runtime are served by `next dev`
#              but are NOT included in a production build.
# "supabase" = uploads to Supabase Storage. Use this in production.
STORAGE_PROVIDER=


# --- Option A: STORAGE_PROVIDER=local  (development only) --------------------
# Relative folder path INSIDE public/. Must resolve inside public/ or uploads fail.
# Resulting files are served at /<STORAGE_DIRECTORY>/<file>.
# Example: STORAGE_DIRECTORY=uploads  ->  public/uploads/ ->  /uploads/abc.png
STORAGE_DIRECTORY=


# --- Option B: STORAGE_PROVIDER=supabase  (production) ----------------------
# Supabase project URL. Project Settings -> API -> Project URL.
# Example: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# SECURITY: server-side only. This key bypasses Row Level Security.
# Never expose it to the browser, never prefix it with NEXT_PUBLIC_,
# never put it in client code. Trust boundary — see AGENTS.md section 3.
# Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket that holds the images. Must already exist in Supabase Storage.
# Optional — defaults to "healthcapsule" when left blank.
SUPABASE_STORAGE_BUCKET=


# =============================================================================
# NOTES
# =============================================================================
# NODE_ENV is set automatically by Next.js/Node — do not add it here.
#
# `scripts/smoke-test.sh` additionally accepts BASE_URL, ADMIN_EMAIL and
# ADMIN_PASSWORD. Those are passed inline in your shell, not stored here:
#     BASE_URL=https://your-domain.vercel.app ADMIN_EMAIL=... ADMIN_PASSWORD=... ./scripts/smoke-test.sh
#
# Vercel: add these under Project -> Settings -> Environment Variables.
# Set DATABASE_URL, NEXTAUTH_SECRET, NEXTAUTH_URL, JWT_SECRET and the three
# SUPABASE_* values for Production. Leave STORAGE_DIRECTORY unset there.
