# Example database connection string (e.g. postgresql://user:password@host:5432/dbname)
DATABASE_URL=

# Secret key for NextAuth session signing (use a long random string)
NEXTAUTH_SECRET=

# Base URL of your app (e.g. http://localhost:3000)
NEXTAUTH_URL=

# JWT secret for staff/admin API auth (openssl rand -base64 32)
JWT_SECRET=
# Initial staff admin credentials (npm run seed:admin)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Image storage: "local" (dev only, writes under public/) or "supabase"
STORAGE_PROVIDER=

# Required when STORAGE_PROVIDER=local. Must be a path inside public/ so files are servable.
# NOTE: runtime writes under public/ are served by `next dev` but NOT in a production build.
STORAGE_DIRECTORY=

# Required when STORAGE_PROVIDER=supabase
SUPABASE_URL=
# Server-side only. Bypasses RLS — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
