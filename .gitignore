# =============================================================================
# HealthCapsule monorepo — root gitignore
# =============================================================================
# Layout:
#   web/     Next.js web app (deployed to Vercel)
#   mobile/  Expo React Native app
# =============================================================================

# --- dependencies -----------------------------------------------------------
node_modules/

# --- env files (never commit real values) -----------------------------------
.env
.env.local
.env.*.local
.env.production

# --- build output -----------------------------------------------------------
.next/
out/
build/
dist/
web-build/
.vercel
*.tsbuildinfo
next-env.d.ts
expo-env.d.ts

# --- native build dirs (generated by expo prebuild) -------------------------
mobile/android/
mobile/ios/

# --- logs -------------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
*.pem

# Windows reserved device names — created accidentally by >/dev/null in Git Bash
nul
NUL

# --- AI tooling (local only, not app code) ----------------------------------
.zcode/
.agents/
.claude/
.playwright-mcp/
skills-lock.json
.kimchi/
graphify-out/

# --- local QA scratch (screenshots, one-off scripts) ------------------------
/*.png
/serve-dist.js
/staff-check.yml

# --- built APK/AAB output ---------------------------------------------------
/apk/
*.apk
*.aab
