# Public, client-bundled API base URL. No secrets here.
# Web preview default points at the local Next.js dev server.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Drops expo-symbols (and its 962KB Material Symbols font) from the Android
# bundle. We use lucide-react-native for icons, so expo-router's native-tabs
# `md` icon path is unused. Already set in eas.json for EAS builds; this is
# for local `expo start` / `expo export`.
EXPO_ROUTER_DISABLE_NATIVE_TABS_MD=1
