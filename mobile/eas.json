{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://health-capsule.vercel.app",
        "EXPO_ROUTER_DISABLE_NATIVE_TABS_MD": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_ROUTER_DISABLE_NATIVE_TABS_MD": "1"
      }
    }
  }
}
